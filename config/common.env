# ==================== 지역 및 신규 서버 포트 ====================
# 컨테이너 시간대 및 예약 시간 기준 - 예: Asia/Seoul, UTC
TZ=Asia/Seoul

# 신규 serverN.env 게임 포트 기준값 - server1에 그대로 사용
# 직접 지정하려면 1024~65534 범위의 숫자를 사용
GAME_PORT_BASE=39471

# 신규 serverN.env REST API 포트 기준값 - GAME_PORT_BASE + 1
REST_API_PORT_BASE=39472

# 서버 번호 증가당 포트 증가값 - serverN: 기준값 + (N-1) × 증가값
SERVER_PORT_STEP=10

# ==================== 설치 및 자동 업데이트 ====================
# true - 컨테이너 시작과 게임 Start/Restart 전에 실제 Steam BuildID 확인
UPDATE_ON_START=true

# true - 실행 중 Steam 공개 빌드 확인 및 자동 업데이트
# 감지 순서 - 60초 공지·10초 카운트다운 → 월드 저장 → 정상 종료 → SteamCMD → 필요 시 재시작
AUTO_UPDATE_ENABLED=true

# 시간 값 형식 - s(초), m(분), h(시간), 예: 60s, 5m, 1h
# Steam 공개 빌드 확인 주기 - 최소 60초
UPDATE_CHECK_INTERVAL=1m

# 자동 업데이트 실패 후 재시도 주기 - 최소 60초
UPDATE_RETRY_INTERVAL=1m

# SteamCMD 다운로드·검증 수치가 바뀌지 않을 때 해당 시도를 다시 시작하기까지의 시간 - 최소 60초
# 예: 5m, 느린 저장장치나 회선에서는 10m
STEAMCMD_PROGRESS_TIMEOUT=5m

# 실행 중 업데이트 전 플레이어 대기 시간
UPDATE_WARNING_SECONDS=60s

# 게임 내 업데이트 최초 안내 - 재시작과 같은 마지막 10초 카운트다운 사용
UPDATE_WARNING_MESSAGE=업데이트를 위해 {time} 뒤 서버가 재시작됩니다.

# true - 매 업데이트마다 전체 파일 검증
# false - 일반 업데이트, 단 필수 파일 누락 시 자동 검증·복구
VALIDATE_ON_UPDATE=true

# 게임 프로세스 비정상 종료 후 재시작 대기 시간
CRASH_RESTART_DELAY=5s

# 내부 종료 처리의 REST API 기본 대기 시간
SHUTDOWN_WAIT=60s

# ==================== 재시작 및 종료 안내 ====================
# 수동·예약 재시작 기본 안내 시간
RESTART_WARNING_SECONDS=60s

# 재시작 최초 공지 - {time}: 1분 또는 30초, {seconds}: 전체 초
RESTART_WARNING_MESSAGE={time} 뒤 서버가 재시작됩니다.

# 재시작 및 업데이트 마지막 10초 공지
RESTART_COUNTDOWN_MESSAGE=서버가 {seconds}초 뒤 재시작됩니다.

# Safe shutdown·safe stop 기본 안내 시간
SHUTDOWN_WARNING_SECONDS=60s

# Safe shutdown·safe stop 최초 공지
SHUTDOWN_WARNING_MESSAGE={time} 뒤 서버가 종료됩니다.

# Safe shutdown·safe stop 마지막 10초 공지
SHUTDOWN_COUNTDOWN_MESSAGE=서버가 {seconds}초 뒤 종료됩니다.

# ==================== API 인증 및 내부 게이트웨이 ====================
# 공식 REST API Basic Auth 사용자명 - 기본 admin, ':' 사용 금지
API_USERNAME=admin

# 컨테이너 내부 통합 API 게이트웨이 포트 - Docker 외부에는 공개하지 않음
# 외부에서는 serverN.env의 PAL_SETTING_RESTAPIPort 하나만 사용
MANAGER_API_PORT=18080

# ==================== 런타임 로그 보관 ====================
# data/serverN/logs/runtime.log 파일당 최대 크기(MiB)
RUNTIME_LOG_MAX_SIZE_MB=20

# runtime.log 순환 보관 파일 개수 - runtime.log.1부터 순서대로 생성
RUNTIME_LOG_BACKUP_COUNT=5
