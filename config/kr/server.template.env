### 안내 사항
# 이후에 적힌 내용은 설정에 대한 설명입니다.
# 그 아래에 = 뒤에 원하는 설정 적어주시면 됩니다.
# 예를 들어,

# 운영 시간 - always 또는 HH:MM-HH:MM, 예: 14:00-02:00
# 예시 1 · ACTIVE_WINDOW 값을 always로 설정

# 이렇게 적혀있다면,
# always는 24시간 운영,
# 04:00-23:00은 4~23시까지 운영을 의미합니다.

# 아래는 서버 설정입니다. Default, Manage, Container and schedule은 건너뛰고, Required부터 확인해주시면 됩니다!
# --------------------------------------------------------------------------------------------------------

# 주석 상태에서는 팰월드 기본값 유지
# 설정 적용 방법 - PAL_SETTING_ 줄의 '# ' 제거 후 서버 재생성
# 공식 v1.0 설정 기준 - https://docs.palworldgame.com/settings-and-operation/configuration/
# (INI 호환 · 공식 v1.0 문서 미등재) 표시는 현재 PalWorldSettings.ini에서 사용하는
# 항목이지만 공식 v1.0 설정 목록에는 설명되지 않은 값입니다. 미지원이라는 뜻은
# 아니며 게임 버전에 따라 동작이 달라질 수 있으므로 변경 전 백업과 검증을 권장합니다.

# ==================== Default ====================
# 공식 REST API 활성화 여부 - palctl·Test·Windows 프로그램 사용을 위해 True 필수
PAL_SETTING_RESTAPIEnabled=True

# true - 공식 REST와 Linux 관리 API를 같은 포트로 외부 공개
# false - 두 API 모두 호스트 127.0.0.1에서만 접근
REST_API_EXPOSE=true

# 플랫폼 인증을 활성화할지 여부 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_bUseAuth=True

# 전용 서버가 내려받을 차단 목록 URL (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_BanListURL=https://b.palworldgame.com/api/banlist.txt

# RCON을 활성화할지 여부
PAL_SETTING_RCONEnabled=False

# RCON 수신 포트 - 사용 시 Docker 포트 게시 추가 필요
# PAL_SETTING_RCONPort=25575

# ==================== Auto-Generated ====================
# Windows 사용자·관리자 프로그램과 외부 API 요청의 추가 인증 토큰
# 신규 서버 생성 시 32자 이상의 임의 값으로 자동 생성
API_ACCESS_TOKEN=

# 공식 REST API가 수신하고 Docker가 게시할 TCP 포트 - 게임 포트 + 1로 자동 할당
PAL_SETTING_RESTAPIPort=39472

# ==================== Manage ====================
# 게임 서버 수신 및 Docker 외부 게시 UDP 포트 - Setup이 자동 할당
SERVER_PORT=39471

# ==================== Container and schedule ====================
# true - 커뮤니티 서버 목록 공개(-publiclobby 자동 추가)
COMMUNITY_SERVER=false

# 커뮤니티 서버에서 외부 공인 IP를 명시적으로 지정할 때 사용
# PAL_SETTING_PublicIP=

# 커뮤니티 서버 목록 외부 포트 - 실제 수신 포트 변경 없음
# PAL_SETTING_PublicPort=39471

# PalServer.sh 추가 실행 인자
# 공식 목록 - https://docs.palworldgame.com/settings-and-operation/arguments/
# 자동 관리 인자 - -port는 SERVER_PORT, -publiclobby는 COMMUNITY_SERVER 사용
# 중복 금지 - SERVER_ARGS에 -port 또는 -publiclobby 직접 추가 금지
# -players=32 - 최대 참가자 수, PAL_SETTING_ServerPlayerMaxNum 사용 권장
# -publicip=x.x.x.x - 커뮤니티 서버 공인 IP 수동 지정
# -publicport=xxxx - 커뮤니티 목록 외부 포트, 실제 수신 포트 변경 없음
# -logformat=text 또는 -logformat=json - 로그 형식
# v1.0 이상 - -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS 미설정 권장
# 스레드 수 직접 지정 시 - 위 세 인자와 -NumberOfWorkerThreadsServer=X 함께 사용
SERVER_ARGS=

# ==================== Required ====================
# 운영 시간 - always 또는 HH:MM-HH:MM, 예: 14:00-02:00
ACTIVE_WINDOW=always

# common.env의 TZ 기준 예약 재시작 - 빈 값이면 비활성화, 여러 시각은 쉼표로 구분
# 예: RESTART_TIMES=04:00,16:00
RESTART_TIMES=04:00

# 서버 목록에 표시할 이름
PAL_SETTING_ServerName=My Palworld Server

# 서버 목록과 REST API 정보에 표시할 설명
PAL_SETTING_ServerDescription=Docker managed Palworld server

# 게임 내 관리자 권한과 REST API Basic Auth에 사용하는 비밀번호
# 프로젝트 자체 길이 제한 없음 · REST API 인증을 위해 빈 값은 사용할 수 없음
PAL_SETTING_AdminPassword=

# 서버 접속 비밀번호 - 프로젝트 자체 길이 제한 없음 · 빈 값이면 비밀번호 없이 접속
PAL_SETTING_ServerPassword=

# 월드 백업 활성화 여부 - 활성화 시 저장 장치 부하 증가
PAL_SETTING_bIsUseBackupSaveData=True

# ==================== Performance and capacity ====================
# 서버에 동시에 접속할 수 있는 최대 플레이어 수
PAL_SETTING_ServerPlayerMaxNum=32

# 협동 세션 하나에 참가할 수 있는 최대 플레이어 수 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_CoopPlayerMaxNum=4

# 서버 전체에서 만들 수 있는 거점의 총 개수
PAL_SETTING_BaseCampMaxNum=128

# 길드 하나의 최대 거점 수 - 공식 최대 10
PAL_SETTING_BaseCampMaxNumInGuild=4

# 거점 하나의 최대 배치 팰 수 - 공식 최대 50, 값 증가 시 서버 부하 증가
PAL_SETTING_BaseCampWorkerMaxNum=20

# 컨테이너 UI가 열려 있을 때 강제로 다시 동기화하는 간격(초)
PAL_SETTING_ItemContainerForceMarkDirtyInterval=1.0

# 팰 보관함 플레이어 데이터 갱신을 확인하는 간격 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_PlayerDataPalStorageUpdateCheckTickInterval=1.0

# 플레이어 한 명의 건축물 수 - 0은 무제한
PAL_SETTING_MaxBuildingLimitNum=0

# 물리 연산을 사용하는 드롭 아이템의 최대 개수
PAL_SETTING_PhysicsActiveDropItemMaxNum=3000

# 월드에 유지할 드롭 아이템의 최대 개수 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_DropItemMaxNum=3000

# 특수 UNKO 드롭 아이템의 최대 개수 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_DropItemMaxNum_UNKO=100

# 플레이어 기준 팰 동기화 거리(cm) - 공식 범위 5000~15000
PAL_SETTING_ServerReplicatePawnCullDistance=15000

# 건축물에 생성한 플레이어의 ID를 표시할지 여부
PAL_SETTING_bEnableBuildingPlayerUIdDisplay=True

# 건축물 이름 표시 캐시 유지 시간(초) (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_BuildingNameDisplayCacheTTLSeconds=10

# ==================== Server management ====================

# (Deprecated) 현재 버전 미지원 - CrossplayPlatforms 사용
# PAL_SETTING_AllowConnectPlatform=raw:Steam

# 접속 허용 플랫폼 - 괄호 표현은 raw: 형식 사용
PAL_SETTING_CrossplayPlatforms=raw:(Steam,Xbox,PS5,Mac)

# 모드를 활성화한 클라이언트의 접속을 허용할지 여부
PAL_SETTING_bAllowClientMod=True

# 전용 서버에서 플레이어 입장과 퇴장 메시지를 표시할지 여부
PAL_SETTING_bIsShowJoinLeftMessage=True

# 플레이어 한 명이 1분 동안 보낼 수 있는 최대 채팅 메시지 수
PAL_SETTING_ChatPostLimitPerMinute=9999

# 서버 로그 형식 - Text 또는 Json
PAL_SETTING_LogFormatType=raw:Text

# 매치메이킹 지역 - 비워두면 게임에서 자동 선택 (INI 호환 · 공식 v1.0 문서 미등재)
# PAL_SETTING_Region=

# ==================== Features ====================
# 글로벌 팰박스로 팰을 내보낼 수 있게 할지 여부
PAL_SETTING_bAllowGlobalPalboxExport=False

# 글로벌 팰박스에서 팰을 가져올 수 있게 할지 여부
PAL_SETTING_bAllowGlobalPalboxImport=False

# 시작 위치를 지도에서 선택할 수 있게 할지 여부
PAL_SETTING_bIsStartLocationSelectByMap=True

# 빠른 이동을 활성화할지 여부
PAL_SETTING_bEnableFastTravel=True

# 빠른 이동을 거점 사이에서만 허용할지 여부
PAL_SETTING_bEnableFastTravelOnlyBaseCamp=False

# 빠른 이동 지점 등 주요 구조물 주변의 건축을 제한할지 여부
PAL_SETTING_bBuildAreaLimit=True

# 길드 한 곳에 가입할 수 있는 최대 플레이어 수
PAL_SETTING_GuildPlayerMaxNum=20

# 길드 탈퇴 후 다시 가입할 수 있을 때까지의 대기 시간(분)
PAL_SETTING_GuildRejoinCooldownMinutes=5

# 길드원이 장기간 접속하지 않으면 건축물과 거점 팰을 자동 삭제할지 여부
PAL_SETTING_bAutoResetGuildNoOnlinePlayers=False

# 길드 자동 삭제가 발동하기까지 아무도 접속하지 않은 시간
PAL_SETTING_AutoResetGuildTimeNoOnlinePlayers=72.0

# 길드장 자동 이전이 가능해지는 미접속 일수 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_AutoTransferMasterThresholdDays=3

# 길드장 자동 이전을 확인하는 간격(초) (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_AutoTransferMasterCheckIntervalSeconds=3600.0

# 프레임당 처리할 최대 길드 레코드 수 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_MaxGuildsPerFrame=10

# 다른 길드의 사망 페널티 드롭을 주울 수 있게 할지 여부 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_bCanPickupOtherGuildDeathPenaltyDrop=False

# 다른 길드 플레이어에 대한 방어를 활성화할지 여부 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_bEnableDefenseOtherGuildPlayer=False

# 사망 페널티 - None, Item, ItemAndEquipment 또는 All
PAL_SETTING_DeathPenalty=raw:All

# 사망 시 보유 팰을 영구적으로 잃을지 여부
PAL_SETTING_bPalLost=False

# 사망 후 다시 부활할 수 있을 때까지의 대기 시간(초)
PAL_SETTING_BlockRespawnTime=5.0

# 다음 사망 때 부활 대기 배율을 적용하기 위한 생존 시간 기준(초)
PAL_SETTING_RespawnPenaltyDurationThreshold=300.0

# 부활 대기 시간에 적용할 배율
PAL_SETTING_RespawnPenaltyTimeScale=1.0

# 금지 기술 ID 목록 - 복합값은 raw: 뒤에 원문 형식 사용
PAL_SETTING_DenyTechnologyList=raw:()

# 거대알 부화 시간(시간) - 다른 알에는 비례 적용
PAL_SETTING_PalEggDefaultHatchingTime=72.0

# 운석 또는 보급품이 떨어지는 간격(분)
PAL_SETTING_SupplyDropSpan=60

# 침략 이벤트를 활성화할지 여부
PAL_SETTING_bEnableInvaderEnemy=True

# 게임 내 음성 채팅을 활성화할지 여부
PAL_SETTING_bEnableVoiceChat=False

# 음성 채팅 소리가 감쇠하기 시작하는 거리
PAL_SETTING_VoiceChatMaxVolumeDistance=4000.0

# 음성 채팅 소리가 완전히 들리지 않게 되는 거리
PAL_SETTING_VoiceChatZeroVolumeDistance=8000.0

# 로그아웃한 플레이어가 해당 위치에 수면 상태로 남을지 여부
PAL_SETTING_bExistPlayerAfterLogout=False

# 다른 길드 거점의 영역 경계를 표시할지 여부
PAL_SETTING_bInvisibleOtherGuildBaseCampAreaFX=False

# ESC 메뉴의 플레이어 목록을 표시할지 여부
PAL_SETTING_bShowPlayerList=True

# 멀티플레이 월드 동작을 활성화할지 여부 - (INI 호환 · 공식 v1.0 문서 미등재) - False로 두시면 됩니다.
PAL_SETTING_bIsMultiplay=False

# 전체 PvP 모드와 별개로 플레이어 간 피해를 허용할지 여부 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_bEnablePlayerToPlayerDamage=False

# 아군 피해를 허용할지 여부 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_bEnableFriendlyFire=False

# UNKO 시스템을 활성화할지 여부 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_bActiveUNKO=False

# 컨트롤러 조준 보정을 활성화할지 여부 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_bEnableAimAssistPad=True

# 키보드 조준 보정을 활성화할지 여부 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_bEnableAimAssistKeyboard=False

# 장기간 접속하지 않은 플레이어에게 페널티를 적용할지 여부 (INI 호환 · 공식 v1.0 문서 미등재) - False로 두시면 됩니다.
PAL_SETTING_bEnableNonLoginPenalty=False

# 포식자 보스 팰을 활성화할지 여부 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_EnablePredatorBossPal=True

# 월드 자동 저장 간격(초) (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_AutoSaveSpan=30.0

# 드롭 아이템이 사라질 때까지의 시간(시간) (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_DropItemAliveMaxHours=1.0

# ==================== Game balances ====================
# 전체 난이도 프리셋 - None, Normal 또는 Hard (INI 호환 · 공식 v1.0 문서 미등재) - None으로 두시면 됩니다.
PAL_SETTING_Difficulty=raw:None

# 낮이 흐르는 속도 배율
PAL_SETTING_DayTimeSpeedRate=1.0

# 밤이 흐르는 속도 배율
PAL_SETTING_NightTimeSpeedRate=1.0

# 팰 포획 확률 배율
PAL_SETTING_PalCaptureRate=1.0

# 팰 출현 수 배율 - 값 증가 시 서버 부하 증가
PAL_SETTING_PalSpawnNumRate=1.0

# 경험치 획득량 배율
PAL_SETTING_ExpRate=1.0

# 아이템 무게 배율
PAL_SETTING_ItemWeightRate=1.0

# 아이템 부패 속도 배율
PAL_SETTING_ItemCorruptionMultiplier=1.0

# 방목으로 생산하는 아이템의 생산 속도 배율
PAL_SETTING_MonsterFarmActionSpeedRate=1.0

# 건축물이 받는 피해 배율
PAL_SETTING_BuildObjectDamageRate=1.0

# 건축물 체력 배율 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_BuildObjectHpRate=1.0

# 건축물 노후화 피해 속도 배율
PAL_SETTING_BuildObjectDeteriorationDamageRate=1.0

# 채집 오브젝트 체력 배율
PAL_SETTING_CollectionObjectHpRate=1.0

# 채집 오브젝트 재생성 간격 배율
PAL_SETTING_CollectionObjectRespawnSpeedRate=1.0

# 채집 아이템 획득량 배율
PAL_SETTING_CollectionDropRate=1.0

# 적이 떨어뜨리는 아이템 수량 배율
PAL_SETTING_EnemyDropItemRate=1.0

# 작업 속도 배율 (INI 호환 · 공식 v1.0 문서 미등재)
PAL_SETTING_WorkSpeedRate=1.0

# ==================== Player ====================
# 플레이어가 주는 피해 배율
PAL_SETTING_PlayerDamageRateAttack=1.0

# 플레이어가 받는 피해 배율
PAL_SETTING_PlayerDamageRateDefense=1.0

# 플레이어 자연 체력 회복 속도 배율
PAL_SETTING_PlayerAutoHPRegeneRate=1.0

# 플레이어 기력 감소 속도 배율
PAL_SETTING_PlayerStaminaDecreaceRate=1.0

# 플레이어 포만도 감소 속도 배율
PAL_SETTING_PlayerStomachDecreaceRate=1.0

# 수면 중 플레이어 체력 회복 속도 배율
PAL_SETTING_PlayerAutoHpRegeneRateInSleep=1.0

# 장비 내구도 감소량 배율
PAL_SETTING_EquipmentDurabilityDamageRate=1.0

# 공격력에 능력치 포인트를 배분할 수 있게 할지 여부
PAL_SETTING_bAllowEnhanceStat_Attack=True

# 체력에 능력치 포인트를 배분할 수 있게 할지 여부
PAL_SETTING_bAllowEnhanceStat_Health=True

# 기력에 능력치 포인트를 배분할 수 있게 할지 여부
PAL_SETTING_bAllowEnhanceStat_Stamina=True

# 소지 중량에 능력치 포인트를 배분할 수 있게 할지 여부
PAL_SETTING_bAllowEnhanceStat_Weight=True

# 작업 속도에 능력치 포인트를 배분할 수 있게 할지 여부
PAL_SETTING_bAllowEnhanceStat_WorkSpeed=True

# ==================== Pal ====================
# 팰이 주는 피해 배율
PAL_SETTING_PalDamageRateAttack=1.0

# 팰이 받는 피해 배율
PAL_SETTING_PalDamageRateDefense=1.0

# 팰의 자연 체력 회복 속도 배율
PAL_SETTING_PalAutoHPRegeneRate=1.0

# 팰 기력 감소 속도 배율
PAL_SETTING_PalStaminaDecreaceRate=1.0

# 팰 포만도 감소 속도 배율
PAL_SETTING_PalStomachDecreaceRate=1.0

# 수면 또는 팰박스 안에서 팰의 체력 회복 속도 배율
PAL_SETTING_PalAutoHpRegeneRateInSleep=1.0

# ==================== Randomized ====================
# 야생 팰 레벨 무작위 범위 - True: 전체 / False: 지역 권장 범위
PAL_SETTING_bIsRandomizerPalLevelRandom=False

# 팰 출현 무작위 모드 - None, Region 또는 All
PAL_SETTING_RandomizerType=raw:None

# 팰 출현 무작위 모드에서 사용할 시드 값
PAL_SETTING_RandomizerSeed=

# ==================== Hardcore ====================
# 하드코어 모드에서 사망 후 캐릭터를 다시 만들 수 있게 할지 여부
PAL_SETTING_bCharacterRecreateInHardcore=False

# 사망 시 부활할 수 없는 하드코어 모드를 활성화할지 여부
PAL_SETTING_bHardcore=False

# ==================== PvP ====================
# 플레이어 간 전투(PvP)를 활성화할지 여부
PAL_SETTING_bIsPvP=False

# PvP 전용 아이템 수를 거점별로 월드맵에 표시할지 여부
PAL_SETTING_bDisplayPvPItemNumOnWorldMap_BaseCamp=False

# 플레이어 위치와 PvP 전용 아이템 수를 월드맵에 표시할지 여부
PAL_SETTING_bDisplayPvPItemNumOnWorldMap_Player=False

# PvP에서 플레이어 처치 시 특별 아이템을 떨어뜨릴지 여부
PAL_SETTING_bAdditionalDropItemWhenPlayerKillingInPvPMode=False

# PvP 처치 시 특별 아이템 드롭을 켰을 때 떨어뜨릴 아이템 ID
PAL_SETTING_AdditionalDropItemWhenPlayerKillingInPvPMode=

# PvP 처치 시 특별 아이템 드롭을 켰을 때 떨어뜨릴 수량
PAL_SETTING_AdditionalDropItemNumWhenPlayerKillingInPvPMode=1
