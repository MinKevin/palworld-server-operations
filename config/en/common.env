# ==================== Locale and new-server ports ====================
# Container timezone and schedule basis - examples: Asia/Seoul, UTC
TZ=Asia/Seoul

# Game-port base for new serverN.env files; used directly by server1
# To set it manually, use a number in the 1024-65534 range
GAME_PORT_BASE=39471

# REST API port base for new serverN.env files; GAME_PORT_BASE + 1
REST_API_PORT_BASE=39472

# Port increment per server number: base + (N-1) x step
SERVER_PORT_STEP=10

# ==================== Installation and automatic updates ====================
# true: check Steam BuildID at container startup and run SteamCMD update/validation for Advanced Start/Restart
UPDATE_ON_START=true

# true: check the public Steam build and update while running
# Sequence: 60-second notice and 10-second countdown -> save -> graceful stop -> SteamCMD -> restart if needed
AUTO_UPDATE_ENABLED=true

# Duration syntax: s (seconds), m (minutes), h (hours); examples: 60s, 5m, 1h
# Public Steam build check interval; minimum 60 seconds
UPDATE_CHECK_INTERVAL=1m

# Retry interval after an automatic-update failure; minimum 60 seconds
# After stale depot-manifest recovery, anonymous access refusals retry after at least 30 minutes
UPDATE_RETRY_INTERVAL=1m

# Restart a SteamCMD attempt when its download or verification counters do not change; minimum 60 seconds
# Examples: 5m, or 10m for especially slow storage or network links
STEAMCMD_PROGRESS_TIMEOUT=5m

# Player warning period before an update
UPDATE_WARNING_SECONDS=60s

# First in-game update notice; the final 10 seconds use the restart countdown message
UPDATE_WARNING_MESSAGE=The server will restart for an update in {time}.

# true: validate all files during every update
# false: use a normal update and automatically validate only when required files are missing
VALIDATE_ON_UPDATE=true

# Delay before restarting after an unexpected game-process exit
CRASH_RESTART_DELAY=5s

# Default REST API wait time used by the internal shutdown path
SHUTDOWN_WAIT=60s

# ==================== Restart and shutdown notices ====================
# Default warning time for manual and scheduled restarts
RESTART_WARNING_SECONDS=60s

# First restart notice: {time} is formatted as 1 minute or 30 seconds; {seconds} is the total seconds
RESTART_WARNING_MESSAGE=The server will restart in {time}.

# Final 10-second restart and update notice
RESTART_COUNTDOWN_MESSAGE=The server will restart in {seconds} seconds.

# Default warning time for safe shutdown and safe stop
SHUTDOWN_WARNING_SECONDS=60s

# First safe shutdown and safe stop notice
SHUTDOWN_WARNING_MESSAGE=The server will shut down in {time}.

# Final 10-second safe shutdown and safe stop notice
SHUTDOWN_COUNTDOWN_MESSAGE=The server will shut down in {seconds} seconds.

# ==================== API authentication and internal gateway ====================
# Official REST API Basic Auth username; defaults to admin and must not contain ':'
API_USERNAME=admin

# Integrated API gateway port inside the container; not published directly by Docker
# External clients use only PAL_SETTING_RESTAPIPort from serverN.env
MANAGER_API_PORT=18080

# ==================== Runtime log retention ====================
# Maximum size of each data/serverN/logs/runtime.log file in MiB
RUNTIME_LOG_MAX_SIZE_MB=20

# Number of rotated runtime.log files, created as runtime.log.1 and later
RUNTIME_LOG_BACKUP_COUNT=5
