### Notes
# The comments below explain each setting.
# Enter the value you want after the = sign on the setting line below each explanation.
# For example:

# Operating-window example
# Operating window: always or HH:MM-HH:MM, for example 14:00-02:00
# Example 1: set ACTIVE_WINDOW to always

# With these examples:
# always runs the server 24 hours a day.
# 04:00-23:00 runs it only from 04:00 through 23:00.

# Server settings follow. Start with Required; Default, Manage, and Container and schedule normally need no changes.
# --------------------------------------------------------------------------------------------------------

# Commented settings keep the Palworld default value
# To apply a setting, remove '# ' from its PAL_SETTING_ line and recreate the server
# Official v1.0 reference: https://docs.palworldgame.com/settings-and-operation/configuration/
# (INI compatibility; not listed in the official v1.0 reference) marks a setting used by
# current PalWorldSettings.ini files but not described in the official v1.0 parameter list.
# It does not necessarily mean unsupported; back up and verify changes after game updates.

# ==================== Default ====================
# Official REST API; this toolkit requires True for palctl, Test, and the Windows clients
PAL_SETTING_RESTAPIEnabled=True

# true: publish the official REST and Linux management APIs on the same host port
# false: bind both APIs to host 127.0.0.1 only
REST_API_EXPOSE=true

# Enable platform authentication (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_bUseAuth=True

# Ban-list URL downloaded by the dedicated server (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_BanListURL=https://b.palworldgame.com/api/banlist.txt

# Enable RCON
PAL_SETTING_RCONEnabled=False

# RCON listening port; Docker publishing must be added separately
# PAL_SETTING_RCONPort=25575

# ==================== Auto-generated ====================
# Additional authentication token used by the Windows clients and external API requests
# A random value of at least 32 characters is generated for every new server
API_ACCESS_TOKEN=

# TCP port for the official REST API and Docker publishing; automatically game port + 1
PAL_SETTING_RESTAPIPort=39472

# ==================== Manage ====================
# UDP port listened on by the game and published by Docker; Setup assigns it automatically
SERVER_PORT=39471

# ==================== Container and schedule ====================
# true: publish to the community server list by automatically adding -publiclobby
COMMUNITY_SERVER=false

# Explicit public IP for community-server publishing
# PAL_SETTING_PublicIP=

# External port shown in the community list; does not change the listening port
# PAL_SETTING_PublicPort=39471

# Extra PalServer.sh arguments
# Official reference: https://docs.palworldgame.com/settings-and-operation/arguments/
# Managed arguments: -port comes from SERVER_PORT and -publiclobby from COMMUNITY_SERVER
# Do not add -port or -publiclobby again in SERVER_ARGS
# -players=32: maximum players; PAL_SETTING_ServerPlayerMaxNum is recommended
# -publicip=x.x.x.x: explicitly set the community-server public IP
# -publicport=xxxx: community-list port; does not change the listening port
# -logformat=text or -logformat=json: log format
# Palworld 1.0+: leaving -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS unset is recommended
# To set worker threads manually, use those three flags with -NumberOfWorkerThreadsServer=X
SERVER_ARGS=

# ==================== Required ====================
# Operating window: always or HH:MM-HH:MM, for example 14:00-02:00
ACTIVE_WINDOW=always

# Scheduled restarts in the configured timezone; empty disables them, comma separates multiple times
# Example: RESTART_TIMES=04:00,16:00
RESTART_TIMES=04:00

# Name shown in the server list
PAL_SETTING_ServerName=My Palworld Server

# Description shown in the server list and REST API information
PAL_SETTING_ServerDescription=Docker managed Palworld server

# Password used for in-game administration and official REST API Basic Auth
# No project-level length limit; it cannot be empty because Basic Auth requires it
PAL_SETTING_AdminPassword=

# Server join password; no project-level length limit, and empty allows password-free joining
PAL_SETTING_ServerPassword=

# World backup toggle; enabling it increases storage I/O
PAL_SETTING_bIsUseBackupSaveData=True

# ==================== Performance and capacity ====================
# Maximum simultaneous players
PAL_SETTING_ServerPlayerMaxNum=32

# Maximum players in one co-op session (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_CoopPlayerMaxNum=4

# Maximum total number of bases in the world
PAL_SETTING_BaseCampMaxNum=128

# Maximum bases per guild; official maximum is 10
PAL_SETTING_BaseCampMaxNumInGuild=4

# Maximum assigned Pals per base; official maximum is 50 and higher values increase load
PAL_SETTING_BaseCampWorkerMaxNum=20

# Forced container-UI synchronization interval in seconds
PAL_SETTING_ItemContainerForceMarkDirtyInterval=1.0

# Interval used to check Pal-storage player-data updates (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_PlayerDataPalStorageUpdateCheckTickInterval=1.0

# Building count per player; 0 means unlimited
PAL_SETTING_MaxBuildingLimitNum=0

# Maximum number of dropped items with active physics
PAL_SETTING_PhysicsActiveDropItemMaxNum=3000

# Maximum number of dropped items retained in the world (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_DropItemMaxNum=3000

# Maximum number of special UNKO dropped items (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_DropItemMaxNum_UNKO=100

# Pal replication distance from a player in cm; official range 5000-15000
PAL_SETTING_ServerReplicatePawnCullDistance=15000

# Show the creator's player ID on buildings
PAL_SETTING_bEnableBuildingPlayerUIdDisplay=True

# Building-name display cache lifetime in seconds (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_BuildingNameDisplayCacheTTLSeconds=10

# ==================== Server management ====================
# (Deprecated) Unsupported by current versions; use CrossplayPlatforms
# PAL_SETTING_AllowConnectPlatform=raw:Steam

# Allowed client platforms; parenthesized expressions use the raw: prefix
PAL_SETTING_CrossplayPlatforms=raw:(Steam,Xbox,PS5,Mac)

# Allow clients with enabled mods to connect
PAL_SETTING_bAllowClientMod=True

# Show dedicated-server join and leave messages
PAL_SETTING_bIsShowJoinLeftMessage=True

# Maximum chat messages per player per minute
PAL_SETTING_ChatPostLimitPerMinute=9999

# Server log format: Text or Json
PAL_SETTING_LogFormatType=raw:Text

# Matchmaking region; empty lets the game choose (INI compatibility; not listed in the official v1.0 reference)
# PAL_SETTING_Region=

# ==================== Features ====================
# Allow exporting Pals through the Global Palbox
PAL_SETTING_bAllowGlobalPalboxExport=False

# Allow importing Pals through the Global Palbox
PAL_SETTING_bAllowGlobalPalboxImport=False

# Allow choosing a starting location from the map
PAL_SETTING_bIsStartLocationSelectByMap=True

# Enable fast travel
PAL_SETTING_bEnableFastTravel=True

# Restrict fast travel to bases
PAL_SETTING_bEnableFastTravelOnlyBaseCamp=False

# Restrict building around major structures such as fast-travel points
PAL_SETTING_bBuildAreaLimit=True

# Maximum players in one guild
PAL_SETTING_GuildPlayerMaxNum=20

# Cooldown in minutes before rejoining a guild after leaving
PAL_SETTING_GuildRejoinCooldownMinutes=5

# Automatically remove buildings and base Pals after a guild is inactive
PAL_SETTING_bAutoResetGuildNoOnlinePlayers=False

# Inactive time before automatic guild cleanup, in hours
PAL_SETTING_AutoResetGuildTimeNoOnlinePlayers=72.0

# Offline days before guild-master auto-transfer can occur (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_AutoTransferMasterThresholdDays=3

# Interval in seconds between guild-master auto-transfer checks (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_AutoTransferMasterCheckIntervalSeconds=3600.0

# Maximum guild records processed per frame (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_MaxGuildsPerFrame=10

# Allow picking up another guild's death-penalty drops (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_bCanPickupOtherGuildDeathPenaltyDrop=False

# Enable defenses against players from other guilds (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_bEnableDefenseOtherGuildPlayer=False

# Death penalty: None, Item, ItemAndEquipment, or All
PAL_SETTING_DeathPenalty=raw:All

# Permanently lose carried Pals on death
PAL_SETTING_bPalLost=False

# Respawn delay after death, in seconds
PAL_SETTING_BlockRespawnTime=5.0

# Survival-time threshold for applying the next-death respawn multiplier, in seconds
PAL_SETTING_RespawnPenaltyDurationThreshold=300.0

# Multiplier applied to respawn delay
PAL_SETTING_RespawnPenaltyTimeScale=1.0

# Denied technology IDs; complex values use the original syntax after raw:
PAL_SETTING_DenyTechnologyList=raw:()

# Huge Egg hatching time in hours; other eggs scale proportionally
PAL_SETTING_PalEggDefaultHatchingTime=72.0

# Meteorite or supply-drop interval in minutes
PAL_SETTING_SupplyDropSpan=60

# Enable invasion events
PAL_SETTING_bEnableInvaderEnemy=True

# Enable in-game voice chat
PAL_SETTING_bEnableVoiceChat=False

# Distance where voice-chat attenuation begins
PAL_SETTING_VoiceChatMaxVolumeDistance=4000.0

# Distance where voice chat becomes inaudible
PAL_SETTING_VoiceChatZeroVolumeDistance=8000.0

# Keep logged-out players sleeping at their last location
PAL_SETTING_bExistPlayerAfterLogout=False

# Show other guilds' base-area boundaries
PAL_SETTING_bInvisibleOtherGuildBaseCampAreaFX=False

# Show the player list in the Escape menu
PAL_SETTING_bShowPlayerList=True

# Multiplayer world behavior (INI compatibility; not listed in the official v1.0 reference); keep this False
PAL_SETTING_bIsMultiplay=False

# Allow players to damage other players independently of full PvP mode (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_bEnablePlayerToPlayerDamage=False

# Allow friendly fire (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_bEnableFriendlyFire=False

# Enable the UNKO system (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_bActiveUNKO=False

# Enable controller aim assist (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_bEnableAimAssistPad=True

# Enable keyboard aim assist (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_bEnableAimAssistKeyboard=False

# Penalties for long-offline players (INI compatibility; not listed in the official v1.0 reference); keep this False
PAL_SETTING_bEnableNonLoginPenalty=False

# Enable predator boss Pals (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_EnablePredatorBossPal=True

# Automatic world-save interval in seconds (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_AutoSaveSpan=30.0

# Hours before dropped items disappear (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_DropItemAliveMaxHours=1.0

# ==================== Game balances ====================
# Overall difficulty preset: None, Normal, or Hard (INI compatibility; not listed in the official v1.0 reference); keep this None
PAL_SETTING_Difficulty=raw:None

# Daytime speed multiplier
PAL_SETTING_DayTimeSpeedRate=1.0

# Nighttime speed multiplier
PAL_SETTING_NightTimeSpeedRate=1.0

# Pal capture-rate multiplier
PAL_SETTING_PalCaptureRate=1.0

# Pal spawn-count multiplier; higher values increase server load
PAL_SETTING_PalSpawnNumRate=1.0

# Experience-gain multiplier
PAL_SETTING_ExpRate=1.0

# Item-weight multiplier
PAL_SETTING_ItemWeightRate=1.0

# Item-decay speed multiplier
PAL_SETTING_ItemCorruptionMultiplier=1.0

# Ranch item-production speed multiplier
PAL_SETTING_MonsterFarmActionSpeedRate=1.0

# Damage taken by buildings multiplier
PAL_SETTING_BuildObjectDamageRate=1.0

# Building health multiplier (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_BuildObjectHpRate=1.0

# Building deterioration-damage multiplier
PAL_SETTING_BuildObjectDeteriorationDamageRate=1.0

# Gatherable-object health multiplier
PAL_SETTING_CollectionObjectHpRate=1.0

# Gatherable-object respawn interval multiplier
PAL_SETTING_CollectionObjectRespawnSpeedRate=1.0

# Gathered-item amount multiplier
PAL_SETTING_CollectionDropRate=1.0

# Enemy item-drop amount multiplier
PAL_SETTING_EnemyDropItemRate=1.0

# Work-speed multiplier (INI compatibility; not listed in the official v1.0 reference)
PAL_SETTING_WorkSpeedRate=1.0

# ==================== Player ====================
# Damage dealt by players multiplier
PAL_SETTING_PlayerDamageRateAttack=1.0

# Damage taken by players multiplier
PAL_SETTING_PlayerDamageRateDefense=1.0

# Natural player HP regeneration multiplier
PAL_SETTING_PlayerAutoHPRegeneRate=1.0

# Player stamina-depletion multiplier
PAL_SETTING_PlayerStaminaDecreaceRate=1.0

# Player hunger-depletion multiplier
PAL_SETTING_PlayerStomachDecreaceRate=1.0

# Sleeping player HP regeneration multiplier
PAL_SETTING_PlayerAutoHpRegeneRateInSleep=1.0

# Equipment durability-damage multiplier
PAL_SETTING_EquipmentDurabilityDamageRate=1.0

# Allow assigning stat points to attack
PAL_SETTING_bAllowEnhanceStat_Attack=True

# Allow assigning stat points to health
PAL_SETTING_bAllowEnhanceStat_Health=True

# Allow assigning stat points to stamina
PAL_SETTING_bAllowEnhanceStat_Stamina=True

# Allow assigning stat points to carry weight
PAL_SETTING_bAllowEnhanceStat_Weight=True

# Allow assigning stat points to work speed
PAL_SETTING_bAllowEnhanceStat_WorkSpeed=True

# ==================== Pal ====================
# Damage dealt by Pals multiplier
PAL_SETTING_PalDamageRateAttack=1.0

# Damage taken by Pals multiplier
PAL_SETTING_PalDamageRateDefense=1.0

# Natural Pal HP regeneration multiplier
PAL_SETTING_PalAutoHPRegeneRate=1.0

# Pal stamina-depletion multiplier
PAL_SETTING_PalStaminaDecreaceRate=1.0

# Pal hunger-depletion multiplier
PAL_SETTING_PalStomachDecreaceRate=1.0

# Sleeping or Palbox Pal HP regeneration multiplier
PAL_SETTING_PalAutoHpRegeneRateInSleep=1.0

# ==================== Randomized ====================
# Wild-Pal level range: True for the full range, False for the recommended regional range
PAL_SETTING_bIsRandomizerPalLevelRandom=False

# Randomized Pal spawn mode: None, Region, or All
PAL_SETTING_RandomizerType=raw:None

# Seed used for randomized Pal spawns
PAL_SETTING_RandomizerSeed=

# ==================== Hardcore ====================
# Allow recreating a character after death in hardcore mode
PAL_SETTING_bCharacterRecreateInHardcore=False

# Enable hardcore mode with no respawn after death
PAL_SETTING_bHardcore=False

# ==================== PvP ====================
# Enable player-versus-player combat
PAL_SETTING_bIsPvP=False

# Show base PvP-item counts on the world map
PAL_SETTING_bDisplayPvPItemNumOnWorldMap_BaseCamp=False

# Show player positions and PvP-item counts on the world map
PAL_SETTING_bDisplayPvPItemNumOnWorldMap_Player=False

# Drop a special item when killing a player in PvP
PAL_SETTING_bAdditionalDropItemWhenPlayerKillingInPvPMode=False

# Special item ID dropped on PvP kills when enabled
PAL_SETTING_AdditionalDropItemWhenPlayerKillingInPvPMode=

# Number of special items dropped on PvP kills when enabled
PAL_SETTING_AdditionalDropItemNumWhenPlayerKillingInPvPMode=1
