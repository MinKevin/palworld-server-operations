test_menu() {
    require_python || return
    while true; do
        echo
        print_servers
        if (( ${#SERVER_NAMES[@]} == 0 )); then
            echo "  Q. 뒤로가기"
            read -r -p "선택 [Q]: " choice
            is_quit_choice "$choice" && return
            echo "Q를 입력하세요." >&2
            continue
        fi
        local all_choice=$(( ${#SERVER_NAMES[@]} + 1 ))
        echo "  $all_choice. 전체 검사"
        echo "  Q. 뒤로가기"
        echo "여러 서버 선택: 1,3 또는 1, 3"
        read -r -p "검사 대상: " choice
        compact="${choice//[[:space:]]/}"
        if is_quit_choice "$compact"; then
            return
        elif [[ "$compact" == "$all_choice" ]]; then
            run_test --server all || true
        elif parse_server_indexes "$choice"; then
            run_test --server "$(join_servers "${SELECTED_SERVERS[@]}")" || true
        else
            echo "잘못된 선택입니다." >&2
        fi
    done
}

remove_menu() {
    require_python || return
    while true; do
        echo
        print_servers
        local all_choice=$(( ${#SERVER_NAMES[@]} + 1 ))
        local project_choice=$(( ${#SERVER_NAMES[@]} + 2 ))
        echo "  $all_choice. 모든 서버와 데이터 제거 (관리 디렉터리 유지)"
        echo "  $project_choice. 전체 제거 후 palworld-docker 관리 디렉터리까지 삭제"
        echo "  Q. 뒤로가기"
        if (( ${#SERVER_NAMES[@]} > 0 )); then
            echo "여러 서버 선택: 1,3 또는 1, 3"
        fi
        read -r -p "삭제 대상: " choice
        compact="${choice//[[:space:]]/}"
        if is_quit_choice "$compact"; then
            return
        elif [[ "$compact" == "$all_choice" ]]; then
            read -r -p "모든 서버와 월드 데이터를 삭제합니다. DELETE 입력: " confirm
            [[ "$confirm" == DELETE ]] && run_privileged_manager remove --all || echo "취소했습니다."
        elif [[ "$compact" == "$project_choice" ]]; then
            echo "삭제 경로: $PALWORLD_PROJECT_DIR"
            read -r -p "Docker를 제외한 모든 서버와 이 디렉터리를 삭제합니다. DELETE PROJECT 입력: " confirm
            if [[ "$confirm" == "DELETE PROJECT" ]]; then
                run_privileged_manager remove --project
                exit 0
            else
                echo "취소했습니다."
            fi
        elif (( ${#SERVER_NAMES[@]} > 0 )) && parse_server_indexes "$choice"; then
            echo "삭제 서버: $(join_servers "${SELECTED_SERVERS[@]}")"
            read -r -p "컨테이너, 설정, 월드/서버 데이터를 삭제합니다. DELETE 입력: " confirm
            [[ "$confirm" == DELETE ]] && run_privileged_manager remove --servers "$(join_servers "${SELECTED_SERVERS[@]}")" || echo "취소했습니다."
        else
            echo "잘못된 선택입니다." >&2
        fi
    done
}

if (( $# > 0 )); then
    command="$1"
    shift
    case "$command" in
        prepare)
            run_setup --prepare-only "$@"
            ;;
        prepare-scaffold) prepare_project_scaffold "$@" ;;
        setup)
            if [[ " ${*:-} " == *" --server "* ]]; then
                run_setup "$@"
            else
                run_setup --next "$@"
            fi
            ;;
        update)
            [[ " ${*:-} " == *" --server "* ]] || { usage >&2; exit 2; }
            run_setup "$@"
            ;;
        test)
            require_python
            run_test "$@"
            ;;
        list)
            require_python
            python3 -B "$PALWORLD_INSTALL_DIR/scripts/instances.py" list "$@"
            ;;
        reset)
            parse_guarded_world_action_arguments reset "$@"
            assert_root
            require_python
            assert_palworld_host_project_owner
            acquire_palworld_project_operation_lock
            python3 -B "$PALWORLD_INSTALL_DIR/scripts/instances.py" \
                assert-server-ownership "$GUARDED_WORLD_SERVER"
            python3 -B "$PALWORLD_INSTALL_DIR/scripts/reset_world.py" \
                --project "$PALWORLD_PROJECT_DIR" "${GUARDED_WORLD_ARGUMENTS[@]}"
            ;;
        restore)
            parse_guarded_world_action_arguments restore "$@"
            require_python
            assert_palworld_host_project_owner
            acquire_palworld_project_operation_lock
            python3 -B "$PALWORLD_INSTALL_DIR/scripts/instances.py" \
                assert-server-ownership "$GUARDED_WORLD_SERVER"
            python3 -B "$PALWORLD_INSTALL_DIR/scripts/restore_world.py" \
                --project "$PALWORLD_PROJECT_DIR" "${GUARDED_WORLD_ARGUMENTS[@]}"
            ;;
        token) manage_server_token "$@" ;;
        apply-env) apply_server_env "$@" ;;
        write-env) write_managed_env "$@" ;;
        host-time) apply_guarded_host_time "$@" ;;
        import-commit) guarded_import_commit "$@" ;;
        import-tool) guarded_import_tool "$@" ;;
        remove)
            case "${1:-}" in
                --all) remove_all_managed ;;
                --project) remove_project_directory ;;
                --servers)
                    [[ $# -ge 2 ]] || { usage >&2; exit 2; }
                    IFS=',' read -r -a selected <<<"${2//[[:space:]]/}"
                    remove_servers "${selected[@]}"
                    ;;
                *) usage >&2; exit 2 ;;
            esac
            ;;
        -h|--help|help) usage ;;
        *) usage >&2; exit 2 ;;
    esac
    exit 0
fi

while true; do
    cat <<'EOF'

팰월드 서버 관리자

  1. Setup  - 신규 서버 설치 및 시작
  2. Manage - 서버 갱신, 월드 초기화·복원 또는 API token 관리
  3. Test   - 설치된 서버 선택 검사
  4. Remove - 개별 서버, 전체 서버 또는 관리 디렉터리 제거
  Q. Exit
EOF
    read -r -p "선택 [1-4, Q]: " menu
    case "$menu" in
        1) setup_menu ;;
        2) manage_menu ;;
        3) test_menu ;;
        4) remove_menu ;;
        q|Q) exit 0 ;;
        *) echo "잘못된 선택입니다." >&2 ;;
    esac
done
