access_token_menu() {
    require_python || return
    while true; do
        local selected_index selected_server action confirm
        echo
        print_configured_servers
        if (( ${#CONFIGURED_SERVER_NAMES[@]} == 0 )); then
            echo "  Q. 뒤로가기"
            read -r -p "선택 [Q]: " selected_index
            is_quit_choice "$selected_index" && return
            echo "Q를 입력하세요." >&2
            continue
        fi
        echo "  Q. 뒤로가기"
        read -r -p "토큰을 관리할 서버 번호: " selected_index
        if is_quit_choice "$selected_index"; then
            return
        elif [[ "$selected_index" =~ ^[0-9]+$ ]] \
            && (( selected_index >= 1 && selected_index <= ${#CONFIGURED_SERVER_NAMES[@]} )); then
            selected_server="${CONFIGURED_SERVER_NAMES[$((selected_index - 1))]}"
        else
            echo "서버 번호 하나를 선택하세요." >&2
            continue
        fi
        while true; do
            cat <<EOF

$selected_server API access token

  1. 현재 토큰 확인
  2. 새 토큰 발급 및 적용
  Q. 뒤로가기
EOF
            read -r -p "선택 [1-2, Q]: " action
            case "$action" in
                1)
                    run_privileged_manager token --server "$selected_server" --show
                    ;;
                2)
                    echo "경고: 기존 토큰은 즉시 폐기되고 해당 컨테이너 설정이 재적용됩니다."
                    read -r -p "계속하려면 ROTATE $selected_server 입력: " confirm
                    if [[ "$confirm" == "ROTATE $selected_server" ]]; then
                        run_privileged_manager token --server "$selected_server" --rotate
                    else
                        echo "취소했습니다."
                    fi
                    ;;
                q|Q) break ;;
                *) echo "잘못된 선택입니다." >&2 ;;
            esac
        done
    done
}

