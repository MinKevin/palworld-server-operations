root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,sh,env,md}]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{yml,yaml}]
end_of_line = lf
indent_style = space
indent_size = 2

[*.{ps1,cs}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
